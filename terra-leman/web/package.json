{
  "name": "terra-leman-web",
  "private": true,
  "version": "0.1.0",
  "description": "Terra Léman web app: interactive 3D map of land and property for sale in the Greater Geneva basin.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "mock": "tsx scripts/generate-mock-data.ts",
    "glyphs": "node scripts/build-glyphs.mjs",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slider": "^1.4.7",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mapbox/tiny-sdf": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  }
}
